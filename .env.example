# Copie este archivo como .env y ajuste los valores. El archivo .env NO se versiona.

# Conexión a base de datos (por defecto: data/processed/cbh_demo.db).
# Ejemplo para un motor externo (requiere instalar su driver):
#   CBH_DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@servidor:5432/cbh
CBH_DATABASE_URL=

# Umbrales del centro de alertas
CBH_ALERT_SALES_DROP_PCT=15
CBH_ALERT_REGION_DROP_PCT=20
CBH_ALERT_MARGIN_DROP_PP=2
CBH_ALERT_CAT_MARGIN_DROP_PP=3
CBH_ALERT_TOP1_SHARE_PCT=10
CBH_ALERT_TOP10_SHARE_PCT=50
CBH_ALERT_COST_INCREASE_PCT=8
CBH_ALERT_OPEX_RATIO_PCT=24
CBH_ALERT_OPEX_INCREASE_PCT=15
CBH_ALERT_MIN_MONTHS=3
CBH_ALERT_MIN_CUSTOMERS=20

# Parámetros de análisis
CBH_ACTIVE_CUSTOMER_DAYS=90
CBH_NO_MOVEMENT_DAYS=90
CBH_MAX_UPLOAD_MB=20
